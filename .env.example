# ========================================
# FTP MCP Server Open — Variables de entorno
# Autor: Joel Chala
# Version: 2.0.0-open
# ========================================

# --- Transporte MCP ---
# stdio = uso local con Claude Code/Desktop
# http  = servidor web con panel, OAuth y MCP HTTP
TRANSPORT=stdio
PORT=3000

# --- Base URL (solo modo http) ---
# URL publica donde esta desplegado el servidor
BASE_URL=http://localhost:3000

# --- Base de datos (solo modo http) ---
# SQLite (default — cero configuracion):
DATABASE_URL="file:./data.db"
# MySQL (opcion avanzada — cambiar provider en prisma/schema.prisma a "mysql"):
# DATABASE_URL=mysql://usuario:password@localhost:3306/ftp_mcp_server_open

# --- Encriptacion de credenciales FTP ---
# Clave AES-256 de 32 bytes en hexadecimal (64 caracteres hex)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- JWT Secret (solo modo http) ---
# Clave para firmar JWT de acceso MCP (puede ser igual a ENCRYPTION_KEY)
# Si no se define, se usa ENCRYPTION_KEY como fallback
JWT_SECRET=

# --- CORS (solo modo http) ---
# Origenes permitidos separados por coma
CORS_ORIGINS=http://localhost:3000

# --- Seguridad del modo http ---
# El primer usuario siempre puede registrarse; despues el registro se cierra salvo que sea true
ALLOW_REGISTRATION=false
# Permite sitios FTP/SFTP en redes internas (localhost, 192.168.x.x, 10.x.x.x...). Dejar en false si es publico
ALLOW_PRIVATE_HOSTS=false

# Acepta certificados FTPS autofirmados (no recomendado)
ALLOW_INSECURE_TLS=false

# --- Conexion FTP/FTPS/SFTP (modo stdio local) ---
FTP_PROTOCOL=sftp
FTP_HOST=tu-servidor.com
FTP_PORT=22
FTP_USER=tu-usuario
FTP_PASSWORD=tu-contrasena

# SFTP: ruta a llave privada (opcional, alternativa a password)
SFTP_PRIVATE_KEY_PATH=
# SFTP: huella SHA-256 (hex) de la host key del servidor; vacio = se registra en el log la primera vez
SFTP_HOST_KEY_SHA256=

# --- Seguridad y limites ---
FTP_BASE_PATH=/public_html
FTP_MAX_FILE_SIZE=524288
FTP_ALLOWED_EXTENSIONS=.php,.html,.css,.js,.json,.txt,.xml,.htaccess,.md,.yml,.yaml,.env,.ini,.conf,.svg,.sql,.twig,.vue,.jsx,.tsx,.ts,.scss,.sass,.less
FTP_READ_TIMEOUT=30000

# --- Entorno ---
NODE_ENV=development
